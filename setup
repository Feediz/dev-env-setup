#!/bin/bash
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Dry-run support: strip --dry-run out of the args wherever it appears, and
# re-append it when dispatching to a script that supports it (env, vscode,
# project). `shell` (setup_my_env) does not support it.
DRY_RUN=false
args=()
for arg in "$@"; do
    if [ "$arg" = "--dry-run" ]; then
        DRY_RUN=true
    else
        args+=("$arg")
    fi
done
set -- "${args[@]}"

dispatch() {
    local script="$1"
    shift
    if [ "$DRY_RUN" = true ]; then
        exec "$script" "$@" --dry-run
    else
        exec "$script" "$@"
    fi
}

show_help() {
    cat <<'EOF'
dev-env-setup - unified entry point

USAGE
  ./setup                          Interactive menu
  ./setup <command> [args...]      Run a command directly
  ./setup help | -h | --help       Show this help
  --dry-run                        Preview actions without making changes
                                    (works with env, vscode, and project;
                                    can go anywhere in the arguments, or be
                                    used alone to dry-run the interactive
                                    menu; not supported by shell)

COMMANDS
  env
      Install core dev tools: Homebrew, Rosetta 2, httpd, mkcert, mysql,
      nvm, VS Code, Chrome, .NET SDK, a JDK, CommandBox. (runs setup_env)

  shell
      Set up shell/terminal experience: oh-my-zsh, plugins, fzf, theme
      picker, GNU coreutils, GPG. (runs setup_my_env)

  vscode [environment] [gitTemplateFile] [extensionListFile]
      Install VS Code extensions and the git commit template for a stack.
      (runs setup-vscode)
      environment: php (default), python, js, terraform, newrelic,
                   docker, db, sfdc, magento, bash, dotnet, cfml, mulesoft
      (dotnet/cfml/mulesoft use extension lists stored in this repo, so
      they require running from a full checkout, not the curl one-liner)

  project setup <name> [www_path] [vhost_file_path] [server_admin]
      Scaffold a local project: copies the project template, creates a
      trusted TLS cert, adds an Apache vhost, and adds a /etc/hosts entry.
      (runs setup-dev-env setup)

  project delete <name> [www_path] [vhost_file_path]
      Remove a local project: deletes its directory, its vhost entry, and
      its /etc/hosts entry. (runs setup-dev-env delete)

EXAMPLES
  ./setup env
  ./setup shell
  ./setup vscode php
  ./setup project setup myproject.test
  ./setup project delete myproject.test
  ./setup env --dry-run
  ./setup --dry-run project setup myproject.test
EOF
}

show_menu() {
    if [ "$DRY_RUN" = true ]; then
        echo "[DRY RUN] No changes will be made."
    fi
    while true; do
        echo "What would you like to do?"
        echo "  1) Install core dev tools (Homebrew, httpd, mkcert, mysql, nvm, VS Code, Chrome)"
        echo "  2) Set up shell/terminal experience (oh-my-zsh, plugins, theme, fzf)"
        echo "  3) Install VS Code extensions for a stack"
        echo "  4) Set up a new local project (vhost + hosts + TLS cert)"
        echo "  5) Delete a local project"
        echo "  6) Help"
        echo "  0) Exit"
        printf "Enter a number: "
        read -r choice

        case "$choice" in
            1)
                dispatch "$SCRIPT_DIR/setup_env"
                ;;
            2)
                if [ "$DRY_RUN" = true ]; then
                    echo "Note: 'shell' (setup_my_env) does not support --dry-run; running normally."
                fi
                exec "$SCRIPT_DIR/setup_my_env"
                ;;
            3)
                printf "Environment (php, python, js, terraform, newrelic, docker, db, sfdc, magento, bash, dotnet, cfml, mulesoft) [php]: "
                read -r env
                dispatch "$SCRIPT_DIR/setup-vscode" "${env:-php}"
                ;;
            4)
                printf "Project name (e.g. myproject.test): "
                read -r name
                dispatch "$SCRIPT_DIR/setup-dev-env" setup "$name"
                ;;
            5)
                printf "Project name to delete: "
                read -r name
                dispatch "$SCRIPT_DIR/setup-dev-env" delete "$name"
                ;;
            6)
                show_help
                ;;
            0)
                exit 0
                ;;
            *)
                echo "Invalid selection."
                ;;
        esac
    done
}

command="${1:-}"

case "$command" in
    "")
        show_menu
        ;;
    help|-h|--help)
        show_help
        ;;
    env)
        shift
        dispatch "$SCRIPT_DIR/setup_env" "$@"
        ;;
    shell)
        shift
        if [ "$DRY_RUN" = true ]; then
            echo "Note: 'shell' (setup_my_env) does not support --dry-run; running normally."
        fi
        exec "$SCRIPT_DIR/setup_my_env" "$@"
        ;;
    vscode)
        shift
        dispatch "$SCRIPT_DIR/setup-vscode" "$@"
        ;;
    project)
        shift
        dispatch "$SCRIPT_DIR/setup-dev-env" "$@"
        ;;
    *)
        echo "Unknown command: $command"
        echo
        show_help
        exit 1
        ;;
esac
