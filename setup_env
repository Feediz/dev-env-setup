#!/bin/bash

# =================================================================
# Dry-run support
# =================================================================
DRY_RUN=false
for arg in "$@"; do
    case "$arg" in
        --dry-run) DRY_RUN=true ;;
    esac
done

# =================================================================
# Setup color constants
# =================================================================
# Reset
Color_Off='\033[0m'       # Text Reset

# Regular Colors
Black='\033[0;30m'        # Black
Red='\033[0;31m'          # Red
Green='\033[0;32m'        # Green
Yellow='\033[0;33m'       # Yellow
Blue='\033[0;34m'         # Blue
Purple='\033[0;35m'       # Purple
Cyan='\033[0;36m'         # Cyan
White='\033[0;37m'        # White

# Bold
BBlack='\033[1;30m'       # Black
BRed='\033[1;31m'         # Red
BGreen='\033[1;32m'       # Green
BYellow='\033[1;33m'      # Yellow
BBlue='\033[1;34m'        # Blue
BPurple='\033[1;35m'      # Purple
BCyan='\033[1;36m'        # Cyan
BWhite='\033[1;37m'       # White

# Underline
UBlack='\033[4;30m'       # Black
URed='\033[4;31m'         # Red
UGreen='\033[4;32m'       # Green
UYellow='\033[4;33m'      # Yellow
UBlue='\033[4;34m'        # Blue
UPurple='\033[4;35m'      # Purple
UCyan='\033[4;36m'        # Cyan
UWhite='\033[4;37m'       # White

# Background
On_Black='\033[40m'       # Black
On_Red='\033[41m'         # Red
On_Green='\033[42m'       # Green
On_Yellow='\033[43m'      # Yellow
On_Blue='\033[44m'        # Blue
On_Purple='\033[45m'      # Purple
On_Cyan='\033[46m'        # Cyan
On_White='\033[47m'       # White

# High Intensity
IBlack='\033[0;90m'       # Black
IRed='\033[0;91m'         # Red
IGreen='\033[0;92m'       # Green
IYellow='\033[0;93m'      # Yellow
IBlue='\033[0;94m'        # Blue
IPurple='\033[0;95m'      # Purple
ICyan='\033[0;96m'        # Cyan
IWhite='\033[0;97m'       # White

# Bold High Intensity
BIBlack='\033[1;90m'      # Black
BIRed='\033[1;91m'        # Red
BIGreen='\033[1;92m'      # Green
BIYellow='\033[1;93m'     # Yellow
BIBlue='\033[1;94m'       # Blue
BIPurple='\033[1;95m'     # Purple
BICyan='\033[1;96m'       # Cyan
BIWhite='\033[1;97m'      # White

# High Intensity backgrounds
On_IBlack='\033[0;100m'   # Black
On_IRed='\033[0;101m'     # Red
On_IGreen='\033[0;102m'   # Green
On_IYellow='\033[0;103m'  # Yellow
On_IBlue='\033[0;104m'    # Blue
On_IPurple='\033[0;105m'  # Purple
On_ICyan='\033[0;106m'    # Cyan
On_IWhite='\033[0;107m'   # White


# =================================================================
# Functions
# =================================================================
function customPrint() {
    msg=$1
    type="info"
    if [ "$2" != "" ]
    then
        type=$2
    fi

    if [ "$type" = "info" ]
    then
        printf "${Green}$msg${Color_Off}\n";
    elif [ "$type" = "error" ]
    then
        printf "${Red}$msg${Color_Off}\n";
    elif [ "$type" = "warning" ]
    then
        printf "${Yellow}$msg${Color_Off}\n";
    else
        printf "$msg\n"
    fi
}

function runCMD() {
    local cmd="$1"
    if [ "$DRY_RUN" = true ] ; then
        customPrint "[DRY RUN] Would run: ( $cmd )" "warning"
    else
        customPrint "Running command: ( $cmd )" "info"
        eval "$cmd"
    fi
}

function checkRosettaInstall() {
    # check if Rosetta 2 is installed (needed for some x86_64 binaries)
    customPrint "Checking if Rosetta 2 is installed ..." "info"
    /usr/bin/pgrep oahd > /dev/null
    if [[ $? != 0 ]] ; then
        customPrint "Installing Rosetta 2 ..." "info"
        runCMD "/usr/sbin/softwareupdate --install-rosetta --agree-to-license"
    else
        customPrint "Rosetta 2 is already installed." "info"
    fi
}

function checkBrewInstall() {
    # check if Homebrew is installed
    customPrint "Checking if Homebrew is installed ..." "info"
    which -s brew
    if [[ $? != 0 ]] ; then
        # Install Homebrew
        if [ "$DRY_RUN" = true ] ; then
            customPrint "[DRY RUN] Would install Homebrew via the official install script" "warning"
        else
            customPrint "Installing Homebrew ..." "info"
            /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
            # Add Homebrew to PATH
            eval "$(/opt/homebrew/bin/brew shellenv)"
        fi
    else
        customPrint "Homebrew is installed ..." "info"
        runCMD "brew update"
    fi
}

function checkHTTPDInstall() {
    # check if httpd is installed
    customPrint "Checking if httpd is installed ..." "info"
    which -s httpd
    if [[ $? != 0 ]] ; then
        # Install httpd
        customPrint "Installing httpd ..." "info"
        runCMD "brew install httpd"
    else
        customPrint "httpd is ${On_IRed}installed${Green} ..." "info"
    fi
}

function checkMKCERTInstall() {
    # check if mkcert is installed
    customPrint "Checking if mkcert is installed ..." "info"
    which -s mkcert
    if [[ $? != 0 ]] ; then
        # Install mkcert
        customPrint "Installing mkcert ..." "info"
        runCMD "brew install mkcert"

        # adding mkcert to local root CAs
        runCMD "mkcert -install"
    else
        customPrint "mkcert is ${On_IRed}installed${Green} ..." "info"
    fi
}

function checkMYSQLInstall() {
    # check if mysql is installed
    customPrint "Checking if mysql is installed ..." "info"
    which -s mysql
    if [[ $? != 0 ]] ; then
        # Install mysql
        customPrint "Installing mysql ..." "info"
        runCMD "brew install mysql"
    else
        customPrint "mysql is ${On_IRed}installed${Green} ..." "info"
    fi
}

function checkNVMInstall() {
    # check if nvm is installed
    customPrint "Checking if nvm is installed ..." "info"
    if [ -s "$HOME/.nvm/nvm.sh" ] ; then
        customPrint "nvm is ${On_IRed}installed${Green} ..." "info"
    else
        # Install nvm via the official installer (Homebrew's nvm formula is not
        # recommended by Homebrew itself for managing Node versions)
        customPrint "Installing nvm ..." "info"
        runCMD "curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.1/install.sh | bash"
    fi
}

function checkVSCodeInstall() {
    # check if vscode is installed
    customPrint "Checking if vscode is installed ..." "info"
    which -s code
    if [[ $? != 0 ]] ; then
        # Install vscode
        customPrint "Installing vscode ..." "info"
        runCMD "brew install --cask visual-studio-code"
    else
        customPrint "vscode is ${On_IRed}installed${Green} ..." "info"
    fi
}

function checkWarpInstall() {
    # check if Warp is installed
    customPrint "Checking if Warp is installed ..." "info"
    which -s warp
    if [[ $? != 0 ]] ; then
        # Install Warp
        customPrint "Installing Warp ..." "info"
        runCMD "brew install --cask warp"
    else
        customPrint "Warp is ${On_IRed}installed${Green} ..." "info"
    fi
}

function checkGoogleChromeInstall() {
    # check if Chrome is installed
    customPrint "Checking if Chrome is installed ..." "info"

    # default chrome installation path
    CHROMEPATH="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"

    if [ -x "$CHROMEPATH" ]; then
        # chrome is installed
        customPrint "Chrome is ${On_IRed}installed${Green} ..." "info"
    else
        # chrome is not installed
        # Install Chrome
        customPrint "Installing Chrome ..." "info"
        runCMD "brew install --cask google-chrome"
    fi
}

function checkDotnetInstall() {
    # check if the .NET SDK is installed
    customPrint "Checking if .NET SDK is installed ..." "info"
    which -s dotnet
    if [[ $? != 0 ]] ; then
        # Install .NET SDK
        customPrint "Installing .NET SDK ..." "info"
        runCMD "brew install --cask dotnet-sdk"
    else
        customPrint ".NET SDK is ${On_IRed}installed${Green} ..." "info"
    fi
}

function checkJDKInstall() {
    # check if a JDK is installed (needed for MuleSoft / Anypoint Code Builder)
    customPrint "Checking if a JDK is installed ..." "info"
    which -s java
    if [[ $? != 0 ]] ; then
        # Install OpenJDK
        customPrint "Installing OpenJDK ..." "info"
        runCMD "brew install openjdk"

        # Register the JDK with the system so /usr/libexec/java_home can find it
        jdkSymlink="/Library/Java/JavaVirtualMachines/openjdk.jdk"
        if [ ! -e "$jdkSymlink" ]; then
            customPrint "Linking OpenJDK into /Library/Java/JavaVirtualMachines ..." "info"
            jdkSymlinkTarget="$(brew --prefix)/opt/openjdk/libexec/openjdk.jdk"
            runCMD "sudo ln -sfn \"$jdkSymlinkTarget\" \"$jdkSymlink\""
        fi
    else
        customPrint "A JDK is ${On_IRed}installed${Green} ..." "info"
    fi
}

function checkCommandBoxInstall() {
    # check if CommandBox (the `box` CLI, used for local CFML development) is installed
    customPrint "Checking if CommandBox is installed ..." "info"
    which -s box
    if [[ $? != 0 ]] ; then
        # Install CommandBox
        customPrint "Installing CommandBox ..." "info"
        runCMD "brew install commandbox"
    else
        customPrint "CommandBox is ${On_IRed}installed${Green} ..." "info"
    fi
}

if [ "$DRY_RUN" = true ] ; then
    customPrint "Running in DRY RUN mode - no changes will be made." "warning"
fi

# Check if Rosetta 2 is needed and install if necessary
checkRosettaInstall

# check if brew exists and install if it doesn't
checkBrewInstall

# install httpd
checkHTTPDInstall

# install mkcert
checkMKCERTInstall

# install mysql
checkMYSQLInstall

# install nvm
checkNVMInstall

# install VSCode
checkVSCodeInstall

# install Google Chrome
checkGoogleChromeInstall

# install .NET SDK
checkDotnetInstall

# install a JDK (needed for MuleSoft / Anypoint Code Builder)
checkJDKInstall

# install CommandBox (CFML local dev server + package manager)
checkCommandBoxInstall
