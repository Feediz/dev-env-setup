#!/bin/bash
 
 
 
# Colors for pretty output
 
GREEN="\033[0;32m"
 
YELLOW="\033[1;33m"
 
RED="\033[0;31m"
 
NC="\033[0m" # No color
 
 
 
ZSH_CUSTOM="${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}"
 
ZSHRC="$HOME/.zshrc"
 
PLUGINS_TO_ADD=(zsh-autosuggestions zsh-syntax-highlighting fzf-tab git z you-should-use)
 
 
 
function print_step() {
 
  echo -e "${YELLOW}==> $1${NC}"
 
}
 
 
 
function print_done() {
 
  echo -e "${GREEN}✔ $1${NC}"
 
}
 
 
 
function print_error() {
 
  echo -e "${RED}✘ $1${NC}"
 
}
 
 
 
# Install Homebrew if missing
 
print_step "Checking for Homebrew..."
 
if ! command -v brew &>/dev/null; then
 
  print_step "Installing Homebrew..."
 
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
 
  print_done "Homebrew installed"
 
else
 
  print_done "Homebrew already installed"
 
fi
 
 
 
# Install Oh My Zsh
 
print_step "Checking for Oh My Zsh..."
 
if [ ! -d "$HOME/.oh-my-zsh" ]; then
 
  print_step "Installing Oh My Zsh..."
 
  sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" "" --unattended
 
  print_done "Oh My Zsh installed"
 
else
 
  print_done "Oh My Zsh already installed"
 
fi
 
 
 
# Install zsh-autosuggestions
 
print_step "Checking for zsh-autosuggestions..."
 
if [ ! -d "$ZSH_CUSTOM/plugins/zsh-autosuggestions" ]; then
 
  git clone https://github.com/zsh-users/zsh-autosuggestions "$ZSH_CUSTOM/plugins/zsh-autosuggestions"
 
  print_done "zsh-autosuggestions installed"
 
else
 
  print_done "zsh-autosuggestions already installed"
 
fi
 
 
 
# Install zsh-syntax-highlighting
 
print_step "Checking for zsh-syntax-highlighting..."
 
if [ ! -d "$ZSH_CUSTOM/plugins/zsh-syntax-highlighting" ]; then
 
  git clone https://github.com/zsh-users/zsh-syntax-highlighting.git "$ZSH_CUSTOM/plugins/zsh-syntax-highlighting"
 
  print_done "zsh-syntax-highlighting installed"
 
else
 
  print_done "zsh-syntax-highlighting already installed"
 
fi
 
 
 
# Install fzf
 
print_step "Checking for fzf..."
 
if ! command -v fzf &>/dev/null; then
 
  brew install fzf
 
  "$(brew --prefix)/opt/fzf/install" --all --no-bash --no-fish
 
  print_done "fzf installed"
 
else
 
  print_done "fzf already installed"
 
fi
 
 
 
# Install fzf-tab
 
print_step "Checking for fzf-tab..."
 
if [ ! -d "$ZSH_CUSTOM/plugins/fzf-tab" ]; then
 
  git clone https://github.com/Aloxaf/fzf-tab "$ZSH_CUSTOM/plugins/fzf-tab"
 
  print_done "fzf-tab installed"
 
else
 
  print_done "fzf-tab already installed"
 
fi
 
 
 
# Install Powerlevel10k
 
print_step "Checking for Powerlevel10k theme..."
 
if [ ! -d "$ZSH_CUSTOM/themes/powerlevel10k" ]; then
 
  git clone --depth=1 https://github.com/romkatv/powerlevel10k.git "$ZSH_CUSTOM/themes/powerlevel10k"
 
  print_done "Powerlevel10k installed"
 
else
 
  print_done "Powerlevel10k already installed"
 
fi
 
 
 
# 7. you-should-use
 
print_step "Checking for you-should-use..."
 
if [ ! -d "$ZSH_CUSTOM/plugins/you-should-use" ]; then
 
  git clone https://github.com/MichaelAquilina/zsh-you-should-use "$ZSH_CUSTOM/plugins/you-should-use"
 
  print_done "you-should-use installed"
 
else
 
  print_done "you-should-use already installed"
 
fi
 
 
 
 
 
# # Update ZSH_THEME in .zshrc
 
# print_step "Setting Powerlevel10k as theme..."
 
# if grep -q '^ZSH_THEME=' "$ZSHRC"; then
 
#   sed -i.bak 's/^ZSH_THEME=.*/ZSH_THEME="powerlevel10k\/powerlevel10k"/' "$ZSHRC"
 
# else
 
#   echo 'ZSH_THEME="powerlevel10k/powerlevel10k"' >> "$ZSHRC"
 
# fi
 
# print_done "Theme set to Powerlevel10k"
# 8. Offer theme selection
print_step "Checking installed themes..."
 
theme_dirs=(
  "$HOME/.oh-my-zsh/themes"
  "$ZSH_CUSTOM/themes"
)
 
theme_list=()
 
for dir in "${theme_dirs[@]}"; do
  if [ -d "$dir" ]; then
    while IFS= read -r -d '' theme_file; do
      theme_name=$(basename "$theme_file" .zsh-theme)
      theme_list+=("$theme_name")
    done < <(find "$dir" -type f -name "*.zsh-theme" -print0)
  fi
done
 
# Remove duplicates and sort
theme_list=($(printf "%s\n" "${theme_list[@]}" | sort -u))
 
if [ ${#theme_list[@]} -eq 0 ]; then
  print_error "No themes found."
else
  echo -e "${YELLOW}Available Zsh themes:${NC}"
  for i in "${!theme_list[@]}"; do
    printf "%3d) %s\n" $((i + 1)) "${theme_list[$i]}"
  done
 
  echo -ne "${YELLOW}Enter the number of the theme to use (or press Enter to skip): ${NC}"
  read -r theme_choice
 
  if [[ "$theme_choice" =~ ^[0-9]+$ ]] && [ "$theme_choice" -ge 1 ] && [ "$theme_choice" -le "${#theme_list[@]}" ]; then
    chosen_theme="${theme_list[$((theme_choice - 1))]}"
    print_step "Setting theme to '$chosen_theme'..."
    if grep -q '^ZSH_THEME=' "$ZSHRC"; then
      sed -i.bak "s/^ZSH_THEME=.*/ZSH_THEME=\"$chosen_theme\"/" "$ZSHRC"
    else
      echo "ZSH_THEME=\"$chosen_theme\"" >> "$ZSHRC"
    fi
    print_done "Theme set to $chosen_theme"
  else
    print_done "No theme change made"
  fi
fi
 
 
 
# Update plugins in .zshrc
 
print_step "Ensuring required plugins are in .zshrc..."
 
 
 
if grep -q '^plugins=' "$ZSHRC"; then
 
  # Extract existing plugin list
 
  current_plugins_line=$(grep '^plugins=' "$ZSHRC")
 
  current_plugins=$(echo "$current_plugins_line" | sed -E 's/plugins=\((.*)\)/\1/' | tr ' ' '\n' | sort -u)
 
  print_step $current_plugins
 
  
 
  # Combine and remove duplicates
 
  all_plugins=$(echo -e "${current_plugins}\n${PLUGINS_TO_ADD[@]}" | sort -u | tr '\n' ' ')
 
  new_plugins_line="plugins=($all_plugins)"
 
  
 
  # Replace the line in .zshrc
 
  sed -i.bak "s/^plugins=.*/$new_plugins_line/" "$ZSHRC"
 
else
 
  echo "plugins=(${PLUGINS_TO_ADD[*]})" >> "$ZSHRC"
 
fi
 
print_done "Updated plugins line in .zshrc"
 
 
 
# Ensure fzf sourcing line exists (but only once)
 
print_step "Ensuring fzf sourcing is in .zshrc..."
 
FZF_LINE='[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh'
 
if ! grep -Fxq "$FZF_LINE" "$ZSHRC"; then
 
  echo "$FZF_LINE" >> "$ZSHRC"
 
  print_done "fzf init line added"
 
else
 
  print_done "fzf init line already exists"
 
fi
 
# Install GNU coreutils
print_step "Checking for coreutils (GNU rm)..."
 
if ! brew list coreutils &>/dev/null; then
  brew install coreutils
  print_done "coreutils installed"
else
  print_done "coreutils already installed"
fi
 
# Use g-prefixed rm from coreutils (e.g., grm doesn't exist; use full path instead)
GNU_RM_PATH="$(brew --prefix coreutils)/libexec/gnubin/rm"
 
if [ -f "$GNU_RM_PATH" ]; then
  print_step "Ensuring alias for GNU rm is in .zshrc..."
  GNU_RM_ALIAS="alias rm='$GNU_RM_PATH -I --preserve-root'"
  if ! grep -Fxq "$GNU_RM_ALIAS" "$ZSHRC"; then
    echo "$GNU_RM_ALIAS" >> "$ZSHRC"
    print_done "Alias for rm added to .zshrc"
  else
    print_done "Alias for rm already exists in .zshrc"
  fi
else
  print_error "GNU rm not found at expected path: $GNU_RM_PATH"
fi
 
# Determine GPG installation path
GPG_PATH="$(command -v gpg)"
 
if [ -x "$GPG_PATH" ]; then
  print_done "GPG found at: $GPG_PATH"
else
  print_step "GPG not found. Installing via Homebrew..."
  
  if command -v brew &>/dev/null; then
    brew install gnupg
    GPG_PATH="$(brew --prefix gnupg)/bin/gpg"
    
    if [ -x "$GPG_PATH" ]; then
      print_done "GPG installed successfully at: $GPG_PATH"
    else
      print_error "GPG installation failed. Please install manually."
      exit 1
    fi
  else
    print_error "Homebrew is not installed. Cannot install GPG automatically."
    exit 1
  fi
fi
 
echo -e "${GREEN}🎉 All done! Run 'source ~/.zshrc' or restart your terminal to apply changes.${NC}"